<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/certledger/db" VERSION="20261019" COMMENT="XMLDB file for Moodle local/certledger"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_certledger" COMMENT="Register of the numbered certificates issued by mod_customcert">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="issueid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="customcert_issues.id (kept after the issue is deleted)"/>
        <FIELD NAME="customcertid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="customcert.id"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Course module id of the certificate activity"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Learner, 0 once anonymised"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="Number series, e.g. CERT-2026"/>
        <FIELD NAME="seq" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Progressive number within the series"/>
        <FIELD NAME="certnumber" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Register number, e.g. CERT-2026-000001"/>
        <FIELD NAME="certcode" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Code printed on the certificate (number plus check suffix)"/>
        <FIELD NAME="origcode" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="Random code originally generated by mod_customcert"/>
        <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lastname" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="email" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="coursename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="certname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="cohorts" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Names of the cohorts of the learner at issue time"/>
        <FIELD NAME="timeissued" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 valid, 1 annulled, 2 removed from the platform"/>
        <FIELD NAME="statusreason" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="statusby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who annulled or removed the certificate"/>
        <FIELD NAME="timestatus" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeblocked" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the re-issue block was set, null if not blocked"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="issueid" UNIQUE="true" FIELDS="issueid"/>
        <INDEX NAME="certnumber" UNIQUE="true" FIELDS="certnumber"/>
        <INDEX NAME="scopeseq" UNIQUE="true" FIELDS="scope, seq"/>
        <INDEX NAME="certcode" UNIQUE="false" FIELDS="certcode"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="timeissued" UNIQUE="false" FIELDS="timeissued"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
